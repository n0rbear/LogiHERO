{
  "name": "logihero-backend",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.js",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:init": "node scripts/db-init.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed": "node scripts/db-seed.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "migration:check": "node scripts/migration-check.js",
    "secret:scan": "node scripts/secret-scan.js",
    "release:gate": "node scripts/release-gate.js",
    "release:gate:release": "node scripts/release-gate.js --release",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/hotel.test.js",
    "test:e2e": "npm run db:init && npm run db:seed && node scripts/run-e2e.js",
    "test:e2e:headed": "npm run db:init && npm run db:seed && node scripts/run-e2e.js --headed",
    "smoke:production": "node scripts/production-smoke.js",
    "typecheck": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2"
  }
}
