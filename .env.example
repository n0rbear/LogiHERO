
NODE_ENV=development
PORT=3000

# PostgreSQL connection used by the LogiHERO backend.
# Do not commit a real production value.
DATABASE_URL=postgresql://logihero_dev:logihero_dev_password@127.0.0.1:5432/logihero_dev

# Admin API protection. Required in production/Render.
ADMIN_TOKEN=replace-with-logihero-admin-token
READ_ONLY_ADMIN_TOKEN=replace-with-logihero-read-only-token
PRODUCTION_SMOKE_ADMIN_TOKEN=
SMOKE_BASE_URL=https://logihero-backend.onrender.com
SMOKE_ALLOW_PARTIAL=false

# Release gate and backup/restore drill.
BACKUP_TARGET=local
BACKUP_DATABASE_URL=
BACKUP_DIR=backups
BACKUP_CONFIRM=
RESTORE_FILE=
RESTORE_DATABASE_URL=
RESTORE_TARGET=local
RESTORE_CONFIRM=
RESTORE_CREATE_DATABASE=false
RESTORE_DROP_DATABASE=false
RELEASE_GATE_MODE=local
RELEASE_GATE_CONNECTED_ANDROID=false

# Safe build metadata exposed by /version and /health/version.
# Set these in production build/deploy configuration.
APP_COMMIT_SHA=unknown
APP_BUILD_TIME=unknown

# Upload limits.
MAX_UPLOAD_BYTES=5242880

# LogiHERO NDP diagnostics. Leave NDP_INGEST_KEY empty to disable diagnostics locally.
NDP_PROJECT_ID=cms0g920d0001v1mom53he7pk
NDP_APP_NAME=LogiHERO
NDP_INGEST_ENDPOINT=http://localhost:4000/api/ingest/events
NDP_INGEST_KEY=
NDP_ENVIRONMENT=development

# Android build-time values.
# This currently also controls the backend Retrofit base URL in the Android app.
NDP_BACKEND_BASE_URL=http://10.0.2.2:3000/
MISTRAL_API_KEY=

# Optional local build notification bot. Do not commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
